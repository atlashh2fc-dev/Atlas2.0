{
  "name": "atlas-lead-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Motor aislado de priorizacion y asignacion de leads de Atlas.",
  "main": "dist/server.js",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
