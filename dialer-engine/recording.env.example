# Agregar estas variables al .env de dialer-engine en la EC2 del dialer.
RECORDING_ENABLED=true
RECORDING_SPOOL_DIR=/var/spool/atlas-recordings
RECORDING_BUCKET=call-recordings
# IP/DNS privado del dialer, alcanzable desde la EC2 Asterisk.
RECORDING_INGEST_BASE_URL=http://10.0.0.10:8080/internal/recordings
RECORDING_UPLOAD_COMMAND=/usr/local/bin/atlas-recording-upload
RECORDING_INGEST_TOKEN_TTL_SECONDS=43200
RECORDING_MAX_UPLOAD_MB=100
RECORDING_RETRY_ATTEMPTS=4
RECORDING_RETRY_BASE_MS=1000
