# Solo servidor. No usar NEXT_PUBLIC_ para estos valores.
# Un secreto HMAC aleatorio distinto por fuente, cada uno de al menos 32 caracteres.
INTEGRATION_HMAC_SECRETS_JSON={"bigdata":"replace-with-random-secret","atlas_lead":"replace-with-another-random-secret"}

# Bearer aleatorio de al menos 32 caracteres para POST /api/integrations/v2/worker.
INTEGRATION_WORKER_SECRET=replace-with-random-worker-secret

# Vercel Cron envía este valor como Authorization: Bearer.
CRON_SECRET=replace-with-random-cron-secret

# Destinos HTTPS para el dispatcher Atlas2 -> plataformas externas. El secreto
# de atlas_lead debe coincidir con INTEGRATION_DISPATCH_SECRET en Atlas Lead.
INTEGRATION_OUTBOX_DESTINATIONS_JSON={"bigdata":{"url":"https://bigdata.geimser.cl/api/commercial-intelligence/atlas-bridge","secret":"replace-with-outbound-random-secret"},"atlas_lead":{"url":"https://lead.example.com/api/integrations/v2/feedback","secret":"replace-with-random-shared-secret-at-least-32-chars"}}

# Handshake CRM -> Atlas Lead para habilitar una campaña sólo después de registrar
# el mapping canónico. URL base HTTPS de Atlas Lead y Bearer compartido sólo servidor.
ATLAS_LEAD_INTEGRATION_URL=https://lead.example.com
INTEGRATION_DISPATCH_SECRET=replace-with-random-shared-secret-at-least-32-chars
